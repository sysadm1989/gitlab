# Ansible этот файл не читает. Пароли лежат в HashiCorp Vault, KV v2, platforms/prod/gitlab.
#
# gitlab_root_password            пароль локального администратора root, от 12 символов
# gitlab_smtp_password            пароль ящика SMTP
# keycloak_client_secret          секрет уже созданного клиента gitlab, от 16 символов
# backup_s3_access_key            ключ доступа к бакету бэкапов
# backup_s3_secret_key            секретный ключ бакета бэкапов

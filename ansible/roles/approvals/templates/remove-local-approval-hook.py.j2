#!/usr/bin/env python3
"""Снимает system hook, который смотрел на локальный сервис апрувов."""

from __future__ import annotations

import json
import ssl
import urllib.error
import urllib.request
from pathlib import Path

TOKEN_FILE = Path("/etc/gitlab-approval/token")
HOST = {{ (gitlab_external_url | urlsplit('hostname')) | to_json }}
LOCAL_MARKER = "127.0.0.1:8765"


def main() -> int:
    if not TOKEN_FILE.exists():
        print("removed=0")
        return 0
    token = TOKEN_FILE.read_text().strip()
    status, hooks = request("GET", "/hooks", token)
    if status != 200 or not isinstance(hooks, list):
        raise SystemExit(f"list hooks failed: {status}")
    removed = 0
    for hook in hooks:
        url = str(hook.get("url") or "")
        if LOCAL_MARKER not in url:
            continue
        deleted, _body = request("DELETE", f"/hooks/{hook['id']}", token)
        if deleted not in {200, 204}:
            raise SystemExit(f"delete hook {hook['id']} failed: {deleted}")
        removed += 1
    print(f"removed={removed}")
    return 0


def request(method: str, path: str, token: str):
    req = urllib.request.Request(
        "https://127.0.0.1/api/v4" + path,
        method=method,
        headers={"PRIVATE-TOKEN": token, "Host": HOST},
    )
    context = ssl._create_unverified_context()
    try:
        with urllib.request.urlopen(req, context=context, timeout=30) as response:
            raw = response.read().decode()
            return response.status, json.loads(raw) if raw else None
    except urllib.error.HTTPError as exc:
        exc.read()
        return exc.code, None


if __name__ == "__main__":
    raise SystemExit(main())

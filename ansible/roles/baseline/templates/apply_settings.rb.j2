local_root = User.find_by(id: 1)
if local_root
  local_root.identities.where(provider: "openid_connect").destroy_all
  local_root.user_synced_attributes_metadata&.destroy
  local_root.reload
  desired_email = ENV["GITLAB_ROOT_EMAIL"]
  if local_root.username != "root" || local_root.email != desired_email || !local_root.admin?
    local_root.skip_reconfirmation!
    restored = Users::UpdateService.new(
      local_root,
      user: local_root,
      username: "root",
      email: desired_email,
      admin: true
    ).execute(check_password: false)
    abort "root restore failed: #{restored[:message]}" unless restored[:status] == :success
    puts "local root restored"
  end
  # Смена primary email оставляет старый адрес в emails. Пока он подтверждён
  # у root, SSO с той же почтой не создаёт отдельного пользователя.
  if desired_email.present?
    removed = Email.where(user_id: local_root.id).where.not(email: desired_email).destroy_all
    puts "removed #{removed.size} secondary emails from root" if removed.any?
  end
end

if ENV["GITLAB_SET_ROOT_PASSWORD"] == "1"
  password = File.read("/etc/gitlab/.root-password-pending").strip
  root = User.find_by_username!("root")
  root.password = password
  root.password_confirmation = password
  root.email = ENV.fetch("GITLAB_ROOT_EMAIL") if root.email != ENV["GITLAB_ROOT_EMAIL"]
  root.skip_reconfirmation! if root.respond_to?(:skip_reconfirmation!)
  unless root.save
    abort "root save failed: #{root.errors.full_messages.join('; ')}"
  end
end

puts "application settings saved"

root = User.find_by_username!("root")
if root.two_factor_enabled?

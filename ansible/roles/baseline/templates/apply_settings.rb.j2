def disable_boolean_columns(table, flags)
  connection = ApplicationRecord.connection
  return unless connection.data_source_exists?(table)

  existing = connection.columns(table).map(&:name)
  chosen = flags.select { |name, _| existing.include?(name) }
  return if chosen.empty?

  assigns = chosen.map do |name, value|
    "#{connection.quote_column_name(name)} = #{value ? "TRUE" : "FALSE"}"
  end
  connection.execute("UPDATE #{connection.quote_table_name(table)} SET #{assigns.join(", ")}")
end

